# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Environment / secrets
.env
.env.local
*.token

# Data caches (connectome snapshots, stimuli caches)
data/connectome/
data/stimuli/__cached__/

# Experiments output (reproducible runs are stored via the harness);
# keep generated plots/metrics but they can be large — uncomment to ignore:
# experiments/**/plots/
# experiments/**/*.json

# Node / frontend
node_modules/
.next/
dist/
build/

# OS
.DS_Store
# Downloaded public anatomy; reproduce with scripts/prepare_live_anatomy.py
data/anatomy/

# User-generated video takes; code, weights and measured JSON stay versionable.
experiments/coding_fly/recordings/
# Published full segment graph and reproducible sparse arrays
data/full_cns/
# Lossless full-CNS activity archives (large); manifests and decisions stay versioned.
experiments/physical_coding/sessions/*/activity-*.bin
experiments/physical_coding/sessions/*/spikes.bin
# New local session captures can contain large screenshots and browser artifacts.
# Curated evidence already tracked in Git remains available; explicitly force-add a
# new session only when it is needed to support a documented result.
experiments/physical_coding/sessions/*/
